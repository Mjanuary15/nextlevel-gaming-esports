<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nl_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Top Back Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                style="@style/Nl.BodyBold"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="❮ Back"
                android:textColor="@color/nl_green"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            style="@style/Nl.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Individual Rigs &amp; Stations"
            android:textSize="22sp" />

        <TextView
            style="@style/Nl.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rent standalone high-performance hardware per hour" />

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- VR Card -->
            <LinearLayout
                android:id="@+id/cardVr"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_outline"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded"
                android:orientation="vertical"
                android:padding="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginBottom="8dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/virtual_reality_experience"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner8dp" />

                <TextView
                    style="@style/Nl.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="VR Gaming"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Meta Quest 3 Wireless Arena"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Nl.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="R100/hr"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/btnAddVr"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Add VR Gaming Setup"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_add_circle"
                        app:tint="@color/nl_green" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Sim Racing Card -->
            <LinearLayout
                android:id="@+id/cardSimRacing"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_outline"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded"
                android:orientation="vertical"
                android:padding="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginBottom="8dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/racing_simulator"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner8dp" />

                <TextView
                    style="@style/Nl.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sim Racing"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Logitech Cockpit &amp; Pedals"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Nl.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="R150/hr"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/btnAddSimRacing"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Add Sim Racing Rig"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_add_circle"
                        app:tint="@color/nl_green" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Console Booth Card -->
            <LinearLayout
                android:id="@+id/cardConsole"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_outline"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded"
                android:orientation="vertical"
                android:padding="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginBottom="8dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ps5_xbox"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner8dp" />

                <TextView
                    style="@style/Nl.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PS5 &amp; Xbox"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="4K 120Hz OLED + 2 Controllers"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Nl.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="R80/hr"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/btnAddConsole"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Add PS5 and Xbox Booth"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_add_circle"
                        app:tint="@color/nl_green" />
                </RelativeLayout>
            </LinearLayout>

            <!-- PC Station Card -->
            <LinearLayout
                android:id="@+id/cardPc"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_outline"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded"
                android:orientation="vertical"
                android:padding="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginBottom="8dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/rtx_4080"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner8dp" />

                <TextView
                    style="@style/Nl.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RTX 4080 PC"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="240Hz Display + Mechanical Gear"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Nl.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="R120/hr"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/btnAddPc"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Add RTX 4080 PC Station"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_add_circle"
                        app:tint="@color/nl_green" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
