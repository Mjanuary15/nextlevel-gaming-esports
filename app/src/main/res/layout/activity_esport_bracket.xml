<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nl_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Top Back Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                style="@style/Nl.BodyBold"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="❮ Back"
                android:textColor="@color/nl_green"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- FC 27 Tournament Header Banner -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_fc27_card"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="FC 27 Banner"
                android:scaleType="centerCrop"
                android:src="@drawable/fc_27" />
        </RelativeLayout>

        <TextView
            style="@style/Nl.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="FC 27 Esports Bracket"
            android:textSize="22sp" />

        <TextView
            style="@style/Nl.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Live Match Scoreboard &amp; Arena Leaderboards" />

        <!-- Match Scoreboard Card -->
        <LinearLayout
            android:id="@+id/cardMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_green"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/Nl.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MATCH #04 - FINALS"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/badgeLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_live_pink"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp">

                    <TextView
                        style="@style/Nl.BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• LIVE"
                        android:textColor="@color/nl_white"
                        android:textSize="10sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Player 1 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    style="@style/Nl.BodyBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. GAMERX"
                    android:textColor="@color/nl_white"
                    android:textSize="16sp" />

                <TextView
                    style="@style/Nl.Price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="2"
                    android:textSize="22sp" />
            </RelativeLayout>

            <!-- Player 2 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/Nl.BodyBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. ShadowNinja_99"
                    android:textColor="@color/nl_white"
                    android:textSize="16sp" />

                <TextView
                    style="@style/Nl.Price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="1"
                    android:textSize="22sp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Leaders Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_panel_purple"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Nl.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="TOP 3 ARENA LEADERS"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Trophy"
                    android:src="@drawable/ic_trophy"
                    app:tint="@color/nl_green" />

                <TextView
                    style="@style/Nl.BodyBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="1. ShadowNinja_99"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Nl.Price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3,450 XP"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    style="@style/Nl.BodyBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="34dp"
                    android:layout_weight="1"
                    android:text="2. GamerX"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Nl.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2,890 XP"
                    android:textColor="@color/nl_lavender"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    style="@style/Nl.BodyBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="34dp"
                    android:layout_weight="1"
                    android:text="3. ApexPredator"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Nl.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2,100 XP"
                    android:textColor="@color/nl_lavender"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
