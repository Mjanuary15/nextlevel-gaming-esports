<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nl_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Header -->
            <TextView
                style="@style/Nl.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Gaming Packages &amp; Experiences"
                android:textSize="22sp" />

            <TextView
                style="@style/Nl.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Next Level Gaming &amp; Esports Arena • Founded by Jason Naidoo" />

            <!-- Category Section 1: Gaming Packages -->
            <TextView
                style="@style/Nl.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Gaming Packages (R1,500 each)"
                android:textColor="@color/nl_green" />

            <!-- Card 1: Ultimate Gamer Pass -->
            <LinearLayout
                android:id="@+id/cardUltimateGamer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_green"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginBottom="12dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ultimate_gamer"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner8dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Nl.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ultimate Gamer Pass"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/Nl.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_badge_green"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="FULL DAY" />
                </RelativeLayout>

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Unlimited gaming access for a full day."
                    android:textColor="@color/nl_white" />

                <TextView
                    style="@style/Nl.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="• PC gaming &amp; Console gaming\n• High-speed internet &amp; Snack voucher\n• Tournament entry included"
                    android:textSize="12sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Nl.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="R1,500"
                        android:textSize="18sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAddUltimateGamer"
                        style="@style/Nl.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Select Package"
                        android:textSize="12sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Card 2: VIP Gaming Experience -->
            <LinearLayout
                android:id="@+id/cardVipExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginBottom="12dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/vip_gaming_experience"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner8dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Nl.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIP Gaming Experience"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/Nl.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_badge_green"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="EXCLUSIVE" />
                </RelativeLayout>

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Premium gaming experience with exclusive facilities."
                    android:textColor="@color/nl_white" />

                <TextView
                    style="@style/Nl.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="• Private gaming booth &amp; Premium equipment\n• Food and drinks &amp; Priority booking\n• Personal gaming assistant"
                    android:textSize="12sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Nl.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="R1,500"
                        android:textSize="18sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAddVipExperience"
                        style="@style/Nl.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Select Package"
                        android:textSize="12sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Card 3: Esports Training Package -->
            <LinearLayout
                android:id="@+id/cardEsportsTraining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginBottom="12dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/esports_training_package"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner8dp" />

                <TextView
                    style="@style/Nl.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Esports Training Package"
                    android:textSize="17sp" />

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Improve competitive gaming skills with professional coaching."
                    android:textColor="@color/nl_white" />

                <TextView
                    style="@style/Nl.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="• Strategy coaching &amp; Team communication\n• Match analysis &amp; Practice sessions\n• Performance feedback report"
                    android:textSize="12sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Nl.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="R1,500"
                        android:textSize="18sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAddEsportsTraining"
                        style="@style/Nl.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Select Package"
                        android:textSize="12sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Card 4: Birthday Party Package -->
            <LinearLayout
                android:id="@+id/cardBirthdayParty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginBottom="12dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/birthday_package"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner8dp" />

                <TextView
                    style="@style/Nl.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Birthday Party Package"
                    android:textSize="17sp" />

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Host a gaming-themed birthday celebration."
                    android:textColor="@color/nl_white" />

                <TextView
                    style="@style/Nl.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="• Reserved gaming area &amp; Multiplayer competitions\n• Party decorations &amp; Catering\n• Tournament prizes included"
                    android:textSize="12sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Nl.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="R1,500"
                        android:textSize="18sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAddBirthdayParty"
                        style="@style/Nl.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Select Package"
                        android:textSize="12sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Category Section 2: Individual Experiences -->
            <TextView
                style="@style/Nl.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Individual Experiences (R750 each)"
                android:textColor="@color/nl_lavender" />

            <!-- Card 5: Virtual Reality Experience -->
            <LinearLayout
                android:id="@+id/cardVrExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginBottom="12dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/virtual_reality_experience"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner8dp" />

                <TextView
                    style="@style/Nl.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Virtual Reality Experience"
                    android:textSize="17sp" />

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Explore immersive virtual reality games. Includes VR headset, games choice &amp; staff assistance."
                    android:textColor="@color/nl_white" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Nl.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="R750"
                        android:textSize="18sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAddVrExperience"
                        style="@style/Nl.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Select Experience"
                        android:textSize="12sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Card 6: Racing Simulator Challenge -->
            <LinearLayout
                android:id="@+id/cardRacingSim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginBottom="12dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/racing_simulator"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner8dp" />

                <TextView
                    style="@style/Nl.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Racing Simulator Challenge"
                    android:textSize="17sp" />

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Race on professional driving simulators. Includes choice of tracks &amp; leaderboard competition."
                    android:textColor="@color/nl_white" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Nl.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="R750"
                        android:textSize="18sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAddRacingSim"
                        style="@style/Nl.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Select Experience"
                        android:textSize="12sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Card 7: Escape Room Challenge -->
            <LinearLayout
                android:id="@+id/cardEscapeRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginBottom="12dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/escape_room"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner8dp" />

                <TextView
                    style="@style/Nl.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Escape Room Challenge"
                    android:textSize="17sp" />

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Solve puzzles and escape before time runs out. Includes team challenge &amp; digital scorecard."
                    android:textColor="@color/nl_white" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Nl.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="R750"
                        android:textSize="18sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAddEscapeRoom"
                        style="@style/Nl.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Select Experience"
                        android:textSize="12sp" />
                </RelativeLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
