<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nl_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/Nl.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your Booking Cart"
                android:textSize="22sp" />

            <TextView
                style="@style/Nl.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select multiple passes to unlock discounts up to 15%!" />

            <!-- Discount Tier Progress Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_green"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvDiscountTier"
                        style="@style/Nl.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0% Discount (Add 2 items for 5% off)"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTierBadge"
                        style="@style/Nl.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_badge_green"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="TIER 0" />
                </RelativeLayout>

                <ProgressBar
                    android:id="@+id/progressDiscount"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="25"
                    android:progressBackgroundTint="@color/nl_purple_track"
                    android:progressTint="@color/nl_green" />

                <TextView
                    android:id="@+id/tvNextTier"
                    style="@style/Nl.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:text="Next: Add 1 more item for 5% off"
                    android:textColor="@color/nl_green" />
            </LinearLayout>

            <!-- Cart rows container -->
            <TextView
                style="@style/Nl.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Selected Items" />

            <LinearLayout
                android:id="@+id/cartContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmpty"
                    style="@style/Nl.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your cart is currently empty" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBrowsePackages"
                    style="@style/Nl.Button.Secondary"
                    android:layout_width="240dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="Browse Packages &amp; Experiences"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Order Summary Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_panel_purple"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Nl.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fee Breakdown &amp; Quotation"
                    android:textSize="15sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Nl.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subtotal" />

                    <TextView
                        android:id="@+id/tvSubtotal"
                        style="@style/Nl.BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="R0" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvDiscountLabel"
                        style="@style/Nl.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Multi-Booking Discount" />

                    <TextView
                        android:id="@+id/tvDiscount"
                        style="@style/Nl.BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="-R0"
                        android:textColor="@color/nl_green" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        style="@style/Nl.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VAT (15%)" />

                    <TextView
                        android:id="@+id/tvVat"
                        style="@style/Nl.BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="R0.00" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/nl_option_stroke" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Nl.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Quoted Total Fee" />

                    <TextView
                        android:id="@+id/tvEstimatedTotal"
                        style="@style/Nl.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="R0.00"
                        android:textSize="22sp" />
                </RelativeLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnProceedDetails"
        style="@style/Nl.Button.Primary"
        android:layout_margin="@dimen/screen_padding"
        android:text="Proceed to Request Booking" />

</LinearLayout>
