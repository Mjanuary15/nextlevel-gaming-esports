<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nl_bg_dark"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/Nl.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Custom Rig &amp; Party Quote"
                android:textSize="22sp" />

            <TextView
                style="@style/Nl.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_green"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="⚡ LIVE QUOTE ENGINE"
                android:textColor="@color/nl_green"
                android:textSize="12sp" />

            <!-- Selection card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvRigSelection"
                    style="@style/Nl.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel_purple"
                    android:padding="12dp"
                    android:text="10 Rigs Selected &amp; 4 Hours"
                    android:textSize="14sp" />

                <!-- Add-on options -->
                <CheckBox
                    android:id="@+id/cbVipLounge"
                    style="@style/Nl.Body"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:buttonTint="@color/nl_green"
                    android:checked="true"
                    android:text="Private VIP Lounge  (+R500)" />

                <CheckBox
                    android:id="@+id/cbServerHost"
                    style="@style/Nl.Body"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/nl_green"
                    android:checked="true"
                    android:text="Tournament Server Host  (+R300)" />

                <CheckBox
                    android:id="@+id/cbCatering"
                    style="@style/Nl.Body"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/nl_green"
                    android:checked="true"
                    android:text="Catering Package  (+R400)" />
            </LinearLayout>

            <!-- Estimated Summary Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_panel_purple"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Nl.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="ESTIMATED SUMMARY"
                    android:textSize="14sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/tvRigsLabel"
                        style="@style/Nl.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10x RTX 4080 Rigs" />

                    <TextView
                        android:id="@+id/tvRigsCost"
                        style="@style/Nl.BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="R1,000" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        style="@style/Nl.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected Add-Ons" />

                    <TextView
                        android:id="@+id/tvAddOnsCost"
                        style="@style/Nl.BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="R800.00" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        style="@style/Nl.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Group Discount (10%)" />

                    <TextView
                        android:id="@+id/tvDiscountAmt"
                        style="@style/Nl.BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="-R180.00"
                        android:textColor="@color/nl_green" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/nl_option_stroke" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Nl.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Total" />

                    <TextView
                        android:id="@+id/tvQuoteTotal"
                        style="@style/Nl.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="R1,620"
                        android:textSize="24sp" />
                </RelativeLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnExpressCheckout"
        style="@style/Nl.Button.Primary"
        android:layout_margin="@dimen/screen_padding"
        android:text="PROCEED TO EXPRESS CHECKOUT" />

</LinearLayout>
