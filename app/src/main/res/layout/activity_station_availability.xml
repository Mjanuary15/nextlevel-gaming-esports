<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nl_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Top Back Navigation Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnBack"
                    style="@style/Nl.BodyBold"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_rounded"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="12dp"
                    android:text="❮ Back"
                    android:textColor="@color/nl_green"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                style="@style/Nl.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Live Station Availability"
                android:textSize="22sp" />

            <TextView
                style="@style/Nl.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Real-Time Hardware Status at Next Level Arena" />

            <!-- Filter Pills -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pillAll"
                        style="@style/Nl.BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_pill_selected"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="All Rigs"
                        android:textColor="@color/nl_black"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/pillPc"
                        style="@style/Nl.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_outline"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="PC PODS"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/pillConsole"
                        style="@style/Nl.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_outline"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="Console Booths"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Station 1: RTX 4080 Gaming PCs -->
            <LinearLayout
                android:id="@+id/cardPcs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_green"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Nl.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RTX 4080 Gaming PCs" />

                    <TextView
                        android:id="@+id/tvPcAvailable"
                        style="@style/Nl.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_badge_green"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="12/16 AVAILABLE" />
                </RelativeLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="16"
                    android:progress="12"
                    android:progressBackgroundTint="@color/nl_purple_track"
                    android:progressTint="@color/nl_green" />

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="240Hz Displays | i9 Processors • Ultra Gaming Setup" />
            </LinearLayout>

            <!-- Station 2: PS5 Pro Booths -->
            <LinearLayout
                android:id="@+id/cardConsoles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Nl.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PS5 Pro Booths" />

                    <TextView
                        android:id="@+id/tvConsoleAvailable"
                        style="@style/Nl.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_badge_green"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="4/8 AVAILABLE" />
                </RelativeLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="8"
                    android:progress="4"
                    android:progressBackgroundTint="@color/nl_purple_track"
                    android:progressTint="@color/nl_green" />

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="4K OLED Screens | DualSense Edge Controllers" />
            </LinearLayout>

            <!-- Station 3: Meta Quest VR Pods (Busy) -->
            <LinearLayout
                android:id="@+id/cardVr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Nl.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meta Quest VR Pods" />

                    <TextView
                        android:id="@+id/tvVrAvailable"
                        style="@style/Nl.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_option_row"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="BUSY (0/4)"
                        android:textColor="@color/nl_red" />
                </RelativeLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="4"
                    android:progress="4"
                    android:progressBackgroundTint="@color/nl_purple_track"
                    android:progressTint="@color/nl_red" />

                <TextView
                    style="@style/Nl.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Est. next available slot: 15 mins" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnReserveNext"
        style="@style/Nl.Button.Primary"
        android:layout_margin="@dimen/screen_padding"
        android:text="Reserve Next Available Station" />

</LinearLayout>
