<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: system splash is the same purple with no icon, so it blends into our screen -->
    <style name="Theme.NextLevel.Splash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/nl_bg</item>
        <item name="android:navigationBarColor">@color/nl_bg_dark</item>
        <item name="android:windowSplashScreenBackground">@color/nl_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>

    <style name="LogoWord">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
